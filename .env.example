# Salesforce OAuth (External Client App / Connected App)
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Must match the Connected App callback URL exactly (HTTP loopback only).
SF_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback

# Production: https://login.salesforce.com
# Sandbox: https://test.salesforce.com
# My Domain (optional): https://YOURDOMAIN.my.salesforce.com
SF_LOGIN_URL=https://login.salesforce.com

# Optional: pre-seeded tokens (refresh flow preferred)
SF_ACCESS_TOKEN=
SF_REFRESH_TOKEN=
SF_TOKEN_STORE_PATH=.ae_tokens/tokens.json

# Account Engagement
# Business Unit ID starts with 0Uv and is 18 characters
PARDOT_BUSINESS_UNIT_ID=
PARDOT_API_VERSION=5

# Production: https://pi.pardot.com
# Sandbox / AE Developer Org: https://pi.demo.pardot.com
PARDOT_API_BASE_URL=https://pi.pardot.com

# OAuth scopes (least privilege default — do not add broad "api" unless required)
SF_OAUTH_SCOPES=pardot_api refresh_token

# MCP transport
# stdio | streamable-http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# REQUIRED when MCP_TRANSPORT=streamable-http (fail-closed)
# bearer: MCP clients send Authorization: Bearer <MCP_HTTP_BEARER_TOKEN>
# proxy: authenticated reverse proxy injects Authorization: Bearer <MCP_HTTP_PROXY_SHARED_SECRET>
# Salesforce tokens are NEVER accepted from MCP clients.
MCP_HTTP_AUTH_MODE=
MCP_HTTP_BEARER_TOKEN=
MCP_HTTP_PROXY_SHARED_SECRET=
# Optional protected-resource / audience URL clients dial (exact match)
MCP_HTTP_RESOURCE_URL=
MCP_HTTP_ISSUER_URL=

# Security (default: read-only)
AE_READ_ONLY=true
AE_ALLOW_CREATE=false
AE_ALLOW_UPDATE=false
AE_ALLOW_DELETE=false
AE_REQUIRE_WRITE_CONFIRMATION=true
AE_REQUIRE_DELETE_CONFIRMATION=true
AE_MAX_RECORDS=200
AE_MAX_CONCURRENT_REQUESTS=5

# HTTP client
AE_HTTP_TIMEOUT_SECONDS=30
AE_HTTP_MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO
AE_AUDIT_LOG_PATH=
