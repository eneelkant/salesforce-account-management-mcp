# Sandbox-only Account Engagement MCP template (no secrets).
# Copy to local .env (gitignored) and fill Consumer Key/Secret + BU ID:
#   cp .env.sandbox.example .env
#
# Do NOT use production login/API hosts here.
# Do NOT commit .env.

# Required — fill from sandbox External Client App
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Exact Connected App callback (HTTP loopback only)
SF_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback

# Sandbox Salesforce login
SF_LOGIN_URL=https://test.salesforce.com

# Least-privilege OAuth scopes
SF_OAUTH_SCOPES=pardot_api refresh_token

# Tokens written by `auth login` (mode 0600); never commit
SF_ACCESS_TOKEN=
SF_REFRESH_TOKEN=
SF_TOKEN_STORE_PATH=.ae_tokens/tokens.json

# Account Engagement sandbox / demo API host
PARDOT_BUSINESS_UNIT_ID=
PARDOT_API_VERSION=5
PARDOT_API_BASE_URL=https://pi.demo.pardot.com

# Read-only smoke — writes must stay disabled
AE_READ_ONLY=true
AE_ALLOW_CREATE=false
AE_ALLOW_UPDATE=false
AE_ALLOW_DELETE=false
AE_REQUIRE_WRITE_CONFIRMATION=true
AE_REQUIRE_DELETE_CONFIRMATION=true
AE_MAX_RECORDS=200
AE_MAX_CONCURRENT_REQUESTS=5

# Local STDIO (no MCP HTTP auth required)
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_HTTP_AUTH_MODE=
MCP_HTTP_BEARER_TOKEN=
MCP_HTTP_PROXY_SHARED_SECRET=

# Opt-in live tests (leave unset until Phase 3 authorization)
# RUN_AE_INTEGRATION=1

LOG_LEVEL=INFO
AE_AUDIT_LOG_PATH=
